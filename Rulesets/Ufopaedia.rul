####listOrder Sorting####
# !THIS IS DIFFRENT FROM WEAPONSEQUIPMENT.RUL! as keeping weapons of the same class together is more important than type of ammo and articles needed to be acounted for.
# Here is how the listOrder IDs are set up
#  0000000
#  ^Type -> | 0 = article, 1 = Gun, 2 = Item
#   ^Catagory   -> |weapons 9 = ammo, 0 = pistol, 1 = smg, 2 = rifle, 3 = sniper, 4 = shotgun, 5 = LMG, 6 = explosives
#    ^^ammo type   |Items   9 = Armor,  0 = Melee, 1 = Other, 2 = ?????, 3 = medical, 4 = Breaching, 5 = Tactical nades, 6 = Explosives, 7=???, 8 = Geoscape items
#      ^^weapon   
#        ^ varient
#
# for example the M16 (Scoped) is
# 1 2 12 07 1,
# ^Item
#   ^Rifle
#     ^^5.56 ammmo
#        ^^ m16 is the 7th 5.56 rifle in the list
#           ^first varient of m16
# DO NOT START WITH ANY 0s otherwise the game will give the wrong ID

