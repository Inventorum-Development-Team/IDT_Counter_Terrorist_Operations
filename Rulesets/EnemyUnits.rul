#Mounted MG Spawners
  - type: STR_TECHNICAL_SPAWNER
    spawnUnit: STR_TERRORIST_TECHNICAL_GLOBAL
    spawnUnitFaction: 1
    invWidth: 1
    invHeight: 1
    battleType: 4
    categories: [ STR_EXPLOSIVES ]
    size: 0.3
    weight: 3
    bigSprite: 2556
    floorSprite: 19
    power: 50
    tuPrime: 25
    damageAlter:
      RandomType: 1
      IgnoreSelfDestruct: true
      ToArmorPre: 0.2
      FixRadius: 3
    damageType: 3
    #battleType: 4
    blastRadius: 3
    fuseType: -2
    listOrder: 316010

#Mounted MG Weapons
  - type: STR_TECHNICAL_MG_GLOBAL
    size: 1
    weight: 47
    battleType: 1
    bigSprite: 5144
    floorSprite: 5144 
    handSprite: 5144 
    reloadSound: 155
    fireSound: 156
    #costBuy: 60000
    #costSell: 30000
    accuracySnap: 15
    #accuracyAuto: 10
    blockBothHands: true
    twoHanded: true
    maxRange: 200
    minRange: 5
    snapRange: 10
    #autoRange: 15
    kneelBonus: 100
    #refNode: *STR_LMG
    tuSnap: 20
    #tuAuto: 75
    #sprayWaypoints: 2
    invWidth: 2
    invHeight: 3
    clipSize: 200
    recover: false
    fixedWeapon: true
    confSnap:
      shots: 5
      name: STR_BURST
      ammoSlot: 0
      arcing: false
    #7.62 NATO stats
    power: 45
    hitAnimation: 26
    hitSound: [301, 302, 303, 304, 305, 306, 307, 308, 309, 310, 311, 312, 313, 314, 315, 316, 317, 318, 319]
    damageType: 1
    bulletSprite: 15
    damageAlter:
      RandomType: 6
      IgnoreOverKill: true
      ToArmorPre: 0.6
    #end ammo stats
    listOrder: 155020

