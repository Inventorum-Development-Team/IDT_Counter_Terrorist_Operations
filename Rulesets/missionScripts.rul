
missionScripts:
  - delete: gameStart
  - delete: recon
  - delete: invasion
  - delete: researchRetaliation
  - delete: beginnerRetaliation
  - delete: experiencedRetaliation
  - delete: veteranRetaliation
  - delete: geniusRetaliation
  - delete: superhumanRetaliation
  - delete: recurringTerror

  #Terror Attack variations ##################################
  #Early game (<4 months in)
  - type: east_eu_terror_attack_early
    missionWeights:
     0:
       TERRORIST_ATTACK_EAST_EU: 100
    executionOdds: 100
    startDelay: 100
    randomDelay: 43200
    regionWeights:
     0:
       REGION_SOVIET_CITIES: 100
    useTable: false
    lastMonth: 3

  - type: usa_terror_attack_early
    missionWeights:
     0:
       TERRORIST_ATTACK_USA: 100
    executionOdds: 100
    startDelay: 100
    randomDelay: 43200
    regionWeights:
     0:
       REGION_AMERICAN_CITIES: 100
    useTable: false
    lastMonth: 3

  - type: west_eu_terror_attack_early
    missionWeights:
     0:
       TERRORIST_ATTACK_WEST_EU: 100
    executionOdds: 100
    startDelay: 100
    randomDelay: 43200
    regionWeights:
     0:
       REGION_EUROPEAN_CITIES: 100
    useTable: false
    lastMonth: 3

  #mid game minor attacks
  - type: east_eu_terror_attack
    missionWeights:
     0:
       TERRORIST_ATTACK_EAST_EU: 100
    executionOdds: 33
    startDelay: 100
    randomDelay: 43200
    regionWeights:
     0:
       REGION_SOVIET_CITIES: 100
    useTable: false
    firstMonth: 4
    label: 1

  - type: usa_terror_attack
    missionWeights:
     0:
       TERRORIST_ATTACK_USA: 100
    executionOdds: 50
    startDelay: 100
    randomDelay: 43200
    regionWeights:
     0:
       REGION_AMERICAN_CITIES: 100
    useTable: false
    firstMonth: 4
    label: 2
    conditionals: [-1]

  - type: west_eu_terror_attack
    missionWeights:
     0:
       TERRORIST_ATTACK_WEST_EU: 100
    executionOdds: 100
    startDelay: 100
    randomDelay: 43200
    regionWeights:
     0:
       REGION_EUROPEAN_CITIES: 100
    useTable: false
    firstMonth: 4
    conditionals: [-1,-2]

