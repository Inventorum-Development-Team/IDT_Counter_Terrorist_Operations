  - type: CHEMTOWN # Thanks to Dioxine
    commands:
    - type: addCraft
    - type: addLine
      direction: both
    - type: addBlock
      size: 2
      executions: 3
    - type: fillArea

  #CMP#
  - type: PORTTFTD6 #6x6 # Thanks to Dioxine
    commands:
    - type: addLine
      direction: vertical
      verticalGroup: 5
      rects:
        - [5, 0, 1, 6]
    - type: addCraft
    - type: addUFO
    - type: addLine
      direction: vertical
    - type: addBlock
      size: 2
      executions: 4
    - type: fillArea
  
  #CMP#
  - type: STANDARDROADS6 #6x6 but works for 5x5 # Thanks to Dioxine
    commands:
    - type: addCraft
    - type: addUFO
    - type: addLine
      label: 1
      direction: vertical
      executionChances: 33
      rects:
        - [1, 1, 4, 1]
    - type: addLine
      label: 2
      conditionals: -1
      executionChances: 50
      direction: horizontal
      rects:
        - [1, 1, 1, 4]
    - type: addLine
      label: 3
      conditionals: [-1, -2]
      direction: both
      rects:
        - [1, 1, 4, 4]
    - type: addBlock
      size: 2
      executions: 4
    - type: addBlock
      conditionals: [-3]
      size: 2
      executions: 1
    - type: fillArea

  #CMP#
  - type: REFINERYS  # Thanks to BulletDesigner
    commands:
    - type: addLine
      label: 1
      direction: vertical
      executionChances: 0
      rects:
        - [1, 1, 1, 4]
    - type: addLine
      label: 2
      executionChances: 100
      direction: horizontal
      rects:
        - [1, 1, 1, 4]
    - type: addCraft
    - type: addUFO
      size: 1
      executions: 1
      executionChances: 100
    - type: addBlock
      size: 2
      executions: 4
    - type: fillArea
      blocks: [3, 4, 5, 6, 7, 8, 13, 14, 15, 16, 17]
      freqs: [2, 2, 2, 2, 2, 2, 1, 2, 2, 2, 2]
      maxUses: [1, 1, 1, 1, 1, 2, 1, 2, 2, 1, 2]
    - type: fillArea

##########################
# OBJ (USA)
##########################
# Map scripts here are modified for 6x6 maps, to avoid having an objective, 
# such as the bomb in bomb defusal, spawn next to the start location.
#
# The way the added commands work, they need to go first, otherwise you end
# up with a large amount of technicals, or bombs.

  #CMP#
  - type: INDUSTRIALSLUM_OBJ # Thanks to Dioxine
    commands:
