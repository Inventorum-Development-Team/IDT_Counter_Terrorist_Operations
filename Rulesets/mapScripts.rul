      blocks: 11
    - type: addBlock # Hangar W
      rects:
        - [0, 4, 2, 2]
      blocks: 12
    - type: addBlock # Runway South
      rects:
        - [4, 4, 2, 2]
      blocks: 17
    - type: addCraft
    - type: addBlock
      executions: 4
      blocks: [07, 10, 14, 15]
      maxUses: [1, 1, 1, 1]
    - type: fillArea
      blocks: [00, 03, 04, 06, 08, 09, 18, 19]
