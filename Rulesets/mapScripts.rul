##########################
# Skyscraper
##########################

  - type: SKYSCRAPER
    commands: 
    - type: addBlock
      size: [3,3,20]
      verticalLevels:
       - type: ground
         size: [3,3,9]
         groups: 1
       - type: middle
         terrain: LITTLEBIRD
         groups: 6
         size: [3,3,5]

##########################
# Office
##########################

# FILIP'S OFFICE
  - type: OFFICE
    commands:
     - type: addBlock
       size: [1,2]
       label: 1
       executionChances: 33
     - type: addBlock
       size: [2,1]
       conditionals: [-1]
       label: 2
       executionChances: 33
     - type: addBlock
       size: [2,2]
       conditionals: [-1,-2]
     - type: addCraft
       terrain: COMRCURBAN
     - type: fillArea
       terrain: COMRCURBAN
       groups: [0,5]

  - type: OFFICE_EAST_EU
    commands:
     - type: addBlock
       size: [1,2]
       label: 1
       executionChances: 33
     - type: addBlock
       size: [2,1]
       conditionals: [-1]
       label: 2
       executionChances: 33
     - type: addBlock
       size: [2,2]
       conditionals: [-1,-2]
     - type: addCraft
       terrain: DAWNCITY_URBANA
     - type: fillArea
       terrain: DOWNTOWN
       #groups: [0,5]

  - type: OFFICE_USA
    commands:
     - type: addBlock
       executionChances: 100
     - type: addCraft
       terrain: DAWNCITY_URBANA
     - type: fillArea
       terrain: INDUSTRIALSLUM
       #groups: [0,5]

# EFREN'S OFFICEs
  - type: CTO_OFFICE
    commands:
     - type: addBlock
       executionChances: 100
       terrain: CTO_OFFICE
       groups: 6
     - type: addCraft
       terrain: EXPANDED_TERROR
     - type: fillArea
       terrain: EXPANDED_TERROR
       #groups: [0,5]

  - type: CTO_OFFICE_WEST_EUROPE
    commands:
     - type: addBlock
       size: [2,2]
       executionChances: 100
       groups: 6
       terrain: CTO_OFFICE_WEST_EUROPE
     - type: addCraft
       terrain: DAWNCITY_URBANA
     - type: fillArea
       terrain: DAWNCITY_URBANA
       #groups: [0,5]

  - type: CTO_OFFICE_EAST_EUROPE
    commands:
     - type: addBlock
