##################################################################################################################################
# UFOS
##################################################################################################################################

ufos:
  - type: STR_TECHNICAL_GLOBAL_UFO
    battlescapeTerrainData:
      name: TECHNICAL_GLOBAL_TERRAIN
      mapDataSets:
        - blanks
        - VILBAN
        - VILBITS
        - CTO_TEST
        - APARTD
        - CTO_TEST2
      mapBlocks:
        - name: CTO_TEST_BREACH_TRUCK
          width: 10
          length: 10
          items: 
            STR_TECHNICAL_SPAWNER:
              - [3, 3, 0]
          fuseTimers:
            STR_TECHNICAL_SPAWNER: [0,0]
  - type: STR_TECHNICAL_GLOBAL_UFO_PARTIAL
    battlescapeTerrainData:
      name: TECHNICAL_GLOBAL_TERRAIN
      mapDataSets:
        - blanks
        - VILBITS
        - CTO_TEST2
      mapBlocks:
        - name: CTO_TEST_BREACH_TRUCK_PARTIAL
          width: 10
          length: 10
          items: 
            STR_TECHNICAL_SPAWNER:
              - [3, 3, 0]
          fuseTimers:
            STR_TECHNICAL_SPAWNER: [0,0]
  - type: STR_TECHNICAL_GLOBAL_UFO_EMPTY
    battlescapeTerrainData:
      name: TECHNICAL_GLOBAL_TERRAIN
      mapDataSets:
        - blanks
        - CTO_TEST2
      mapBlocks:
        - name: CTO_TEST_BREACH_TRUCK_EMPTY
          width: 10
          length: 10
          items: 
            STR_TECHNICAL_SPAWNER:
              - [3, 3, 0]
          fuseTimers:
            STR_TECHNICAL_SPAWNER: [0,0]
  - type: STR_BOMB_UFO
    battlescapeTerrainData:
      name: BOMB_SITE_1
      mapDataSets:
        - blanks
        - ACHURCH
        - ACHURCH2
      mapBlocks:
        - name: CTO_BOMBSITE_STATUE01
          width: 10
          length: 10
          items: 
            STR_BOMB_SPAWNER:
              - [4, 4, 0]
          fuseTimers:
            STR_BOMB_SPAWNER: [0,0]
  - type: STR_BOMB_UFO_WAREHOUSE
    battlescapeTerrainData:
      name: BOMB_SITE_2
      mapDataSets:
        - blanks
        - PORTROADS
        - INDUSLUM
        - CTO_TEST
      mapBlocks:
        - name: CTO_BOMBSITE_WAREHOUSE01
          width: 10
          length: 10
          items: 
            STR_BOMB_SPAWNER:
              - [4, 4, 0]
          fuseTimers:
            STR_BOMB_SPAWNER: [0,0]