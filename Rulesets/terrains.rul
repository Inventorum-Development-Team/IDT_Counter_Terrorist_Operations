##########################
# OBJ (East EU)
##########################
# Map here use mapscripts that are modified for 6x6 maps, to avoid having an objective, 
# such as the bomb in bomb defusal, spawn next to the start location.

  - name: EXPANDED_TERROR_OBJ
    refNode: *EXPANDED_TERROR
    script: EXPANDED_TERROR_OBJ
  
  - name: RURAL_OBJ
    refNode: *RURAL
    script: RURAL_OBJ
  
  - name: RAILYARD_OBJ
    refNode: *RAILYARD
    script: RAILYARDURBAN_OBJ

  - name: DOWNTOWN_OBJ
    refNode: *DOWNTOWN
    script: DOWNTOWNURBAN_OBJ

